{
  "collectionName": "components_shared_nav_items",
  "info": {
    "displayName": "NavItem"
  },
  "options": {},
  "attributes": {
    "label": {
      "type": "string"
    },
    "children": {
      "type": "component",
      "component": "shared.nav-dropdown-item",
      "repeatable": true
    },
    "linkType": {
      "type": "enumeration",
      "enum": [
        "page",
        "product-category",
        "post-category",
        "post",
        "custom"
      ]
    },
    "url": {
      "type": "string",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "linkType"
            },
            "custom"
          ]
        }
      }
    },
    "page": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::page.page",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "linkType"
            },
            "page"
          ]
        }
      }
    },
    "post_category": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::post-category.post-category",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "linkType"
            },
            "post-category"
          ]
        }
      }
    },
    "product_category": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::product-category.product-category",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "linkType"
            },
            "product-category"
          ]
        }
      }
    },
    "post": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::post.post",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "linkType"
            },
            "post"
          ]
        }
      }
    }
  },
  "config": {}
}
