{
  "kind": "collectionType",
  "collectionName": "pages",
  "info": {
    "singularName": "page",
    "pluralName": "pages",
    "displayName": "Page"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "Title": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "Title"
    },
    "SeoSetting": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "seo-meta.seo-meta",
      "repeatable": false
    },
    "contentBlocks": {
      "type": "dynamiczone",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "components": [
        "blocks.hero",
        "blocks.product-grid",
        "blocks.rich-text",
        "blocks.image-with-text",
        "blocks.faq",
        "blocks.video",
        "blocks.icon-list",
        "blocks.logo-wall",
        "blocks.testimonials",
        "blocks.contact-form",
        "blocks.announcement-bar",
        "blocks.recent-posts",
        "blocks.team",
        "blocks.trust-badges",
        "blocks.global-offices",
        "blocks.case-studies",
        "blocks.resource-download",
        "blocks.rich-content"
      ]
    }
  }
}
