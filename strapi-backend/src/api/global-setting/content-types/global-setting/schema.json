      "type": "string"
    },
    "siteDescription": {
      "type": "text"
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "favicon": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "contactEmail": {
      "type": "email"
    },
    "phoneNumber": {
      "type": "string"
    },
    "address": {
      "type": "text"
    },
    "socialLinks": {
      "type": "component",
      "component": "social-links.social-links",
      "repeatable": true
    },
    "platform": {
      "type": "enumeration",
      "enum": [
        "LinkedIn",
        "YouTube",
        "Twitter",
        "Facebook",
        "Instagram",
        "TikTok",
        "WhatsApp"
      ]
    },
